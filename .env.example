# ---------------- Core ----------------
PUBLIC_HOST=memory.example.com
PUBLIC_ORIGIN=https://memory.example.com
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=50
BULK_MAX_FILES=1000
BULK_MAX_TOTAL_MB=500
ZIP_MAX_EXPANDED_MB=500

# ---------------- PostgreSQL ----------------
POSTGRES_DB=memorybank
POSTGRES_USER=memorybank
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
DATABASE_URL=postgresql://memorybank:CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD@db:5432/memorybank

# ---------------- Redis ----------------
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD@redis:6379/0

# ---------------- Ollama ----------------
OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIMENSIONS=384
CHAT_MODEL=qwen3:4b
CHAT_IMPORT_CHUNK_CHARS=14000
CHAT_IMPORT_MAX_CANDIDATES_PER_CHUNK=12

# ---------------- MinIO ----------------
MINIO_ROOT_USER=memorybank
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_MINIO_PASSWORD
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=memorybank
MINIO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_MINIO_PASSWORD
MINIO_BUCKET=memorybank
MINIO_SECURE=false

# Cloudflare Tunnel is intentionally managed on the host, outside Compose.

# ---------------- Backups ----------------
BACKUP_ENCRYPTION_PASSWORD=CHANGE_ME_LONG_RANDOM_BACKUP_PASSWORD
BACKUP_RETENTION_DAYS=14
