# ---------------- Core ----------------
PUBLIC_HOST=engram.example.com
PUBLIC_ORIGIN=https://engram.example.com
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=50
BULK_MAX_FILES=1000
BULK_MAX_TOTAL_MB=500
ZIP_MAX_EXPANDED_MB=500

# ---------------- PostgreSQL ----------------
POSTGRES_DB=engram
POSTGRES_USER=engram
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
DATABASE_URL=postgresql://engram:CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD@db:5432/engram

# ---------------- Redis ----------------
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD@redis:6379/0

# ---------------- Ollama ----------------
OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIMENSIONS=384
CHAT_MODEL=qwen3:4b
CHAT_IMPORT_CHUNK_CHARS=14000
CHAT_IMPORT_MAX_CANDIDATES_PER_CHUNK=12

# ---------------- MinIO ----------------
MINIO_ROOT_USER=engram
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_MINIO_PASSWORD
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=engram
MINIO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_MINIO_PASSWORD
MINIO_BUCKET=engram
MINIO_SECURE=false

# Cloudflare Tunnel is intentionally managed on the host, outside Compose.

# ---------------- Backups ----------------
BACKUP_ENCRYPTION_PASSWORD=CHANGE_ME_LONG_RANDOM_BACKUP_PASSWORD
BACKUP_RETENTION_DAYS=14


# ---------------- Ingestion Mesh / Connectors ----------------
# GitHub App credentials. The private key is a file mounted from ./secrets/.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
CONNECTOR_SCHEDULER_INTERVAL_SECONDS=60
GITHUB_MAX_ITEMS_PER_SYNC=300
GITHUB_MAX_FILE_KB=512

# Gmail read-only connector. Keep these server-side; never expose them to the web app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Browser capture / connector source limits
CAPTURE_MAX_CHARS=500000


# ---------------- OAuth / MCP Identity ----------------
# Short-lived OAuth access tokens with rotating refresh tokens.
OAUTH_ACCESS_TOKEN_MINUTES=15
OAUTH_REFRESH_TOKEN_DAYS=30
OAUTH_AUTHORIZATION_CODE_MINUTES=5

# Client ID Metadata Document fetch controls.
OAUTH_CIMD_TIMEOUT_SECONDS=5
OAUTH_CIMD_MAX_KB=256

# Legacy Dynamic Client Registration remains enabled for MCP clients that
# have not moved to Client ID Metadata Documents yet.
OAUTH_DCR_ENABLED=true


# ---------------- Disaster Recovery ----------------
# DR monitor scans encrypted backup artifacts and records verification evidence.
DR_MONITOR_INTERVAL_SECONDS=300
DR_MAX_BACKUP_AGE_HOURS=36
DR_RESTORE_TEST_INTERVAL_HOURS=24
DR_RESTORE_TEST_MAX_AGE_HOURS=36
DR_RESTORE_TEST_ENABLED=true

# Optional off-host replication. The remote uses rclone syntax, for example:
# b2:engram-backups or s3:engram-backups
# Leave blank to keep replication disabled.
DR_OFFSITE_REMOTE=
DR_OFFSITE_CONFIG_PATH=/run/secrets/rclone.conf
DR_OFFSITE_INTERVAL_HOURS=6

# Safety threshold used by the dashboard for the backup filesystem.
DR_MIN_BACKUP_FREE_GB=10
