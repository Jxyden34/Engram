{
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128 {$TRUSTED_PROXY_CIDRS}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

:8080 {
	encode zstd gzip

	handle /install.sh {
		root * /srv/engram
		header Content-Type "text/x-shellscript; charset=utf-8"
		header Cache-Control "no-store"
		file_server
	}

	@internal path /internal/*
	respond @internal 404

	@backend path /api/* /mcp /mcp/* /health /.well-known/* /oauth/*
	header @backend Cache-Control "no-store"
	reverse_proxy @backend api:8000 {
		header_up -CF-Connecting-IP
		header_up X-Forwarded-For {client_ip}
	}

	reverse_proxy web:3000

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
