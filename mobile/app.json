{
  "expo": {
    "name": "Engram Beta",
    "slug": "engram-mobile",
    "version": "3.7.0-dev-beta.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jxyden34.engram.beta",
      "buildNumber": "10"
    },
    "android": {
      "package": "com.jxyden34.engram.beta",
      "versionCode": 13,
      "adaptiveIcon": {
        "backgroundColor": "#111317",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "release": "3.7.0-dev-beta.9",
      "eas": {
        "projectId": "4bfa32da-3316-4752-aa52-605ded14d3c2"
      }
    },
    "owner": "jxyden34",
    "runtimeVersion": "3.7.0-dev-beta.9-native1",
    "scheme": "engram",
    "updates": {
      "url": "https://u.expo.dev/4bfa32da-3316-4752-aa52-605ded14d3c2"
    },
    "plugins": [
      [
        "expo-sharing",
        {
          "android": { "enabled": true, "singleShareMimeTypes": ["text/plain", "text/uri-list"] },
          "ios": {
            "enabled": true,
            "activationRule": { "supportsText": true, "supportsWebUrlWithMaxCount": 1 }
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "Allow Engram to turn your speech into an editable memory draft.",
          "microphonePermission": "Allow Engram to capture speech for a memory you review before saving."
        }
      ]
    ]
  }
}
